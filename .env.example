# Local sample workflow or isolated hosted synthetic staging only.
PERSISTENCE_MODE=local-synthetic
APP_ENV=local
# Temporary local synthetic access only; hosted/remote origins refuse bypass.
LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_USER_ID=
REAL_CV_DATA_ENABLED=false
# Optional expiring SHARED FICTIONAL public pilot only. No administration access.
TEMP_PUBLIC_ACCESS=false
TEMP_PUBLIC_ACCESS_UNTIL=
TEMP_PUBLIC_ACTOR_ID=
APP_URL=
WORKSPACE_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct provider. Disabled until account/capability checks; no gateway/fallback.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL_ID=
# One reservation, processing attempt or criteria draft consumes one allowance unit.
MONTHLY_PROCESSING_ALLOWANCE=240
# Sandbox controller only. No values enter parser VM.
VERCEL_OIDC_TOKEN=
# For explicit local Sandbox SDK authentication, if needed:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
PARSER_SNAPSHOT_ID=
PARSER_BUNDLE_SHA256=
CRON_SECRET=
# Setup/recovery process only. Existing invited administrator UUID, not password.
BOOTSTRAP_ADMIN_USER_ID=
RESTORE_SYNTHETIC_CONFIRM=
