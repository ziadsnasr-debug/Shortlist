# Synthetic only. Real-CV mode is deliberately unavailable.
PERSISTENCE_MODE=local-synthetic
APP_ENV=local
REAL_CV_DATA_ENABLED=false
# Hosted synthetic staging uses supabase-synthetic and isolated credentials.
APP_URL=
WORKSPACE_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stage 4 only; currently unused. No model alias is assumed valid.
ANTHROPIC_API_KEY=
AI_MODEL_ID=
# Stage 3 only; currently unused.
VERCEL_OIDC_TOKEN=
PARSER_SNAPSHOT_ID=
CRON_SECRET=
# Setup process only; existing invited user UUID, never a password.
BOOTSTRAP_ADMIN_USER_ID=
