{
  "name": "shortlist",
  "version": "0.4.0",
  "description": "Shortlist synthetic workflow POC",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
