    "restore": "tsx scripts/restore.ts",
    "ledger:export": "tsx scripts/export-ledger.ts",
    "provider:spike": "node --conditions=react-server --import tsx scripts/provider-spike.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:start": "node --env-file=.env.vercel-auth.local node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3218",
    "local:authenticator": "node --env-file=.env.local --import tsx scripts/local-authenticator.ts",
    "test:live-local": "tsx tests/live-local.ts",
    "preflight": "tsx scripts/preflight.ts --check",
    "test:recovery": "tsx tests/recovery-integration.ts",
    "benchmark:jev": "node --conditions=react-server --import tsx scripts/benchmark/run.ts"
  },
